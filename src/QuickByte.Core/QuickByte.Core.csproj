<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>QuickByte.Core</RootNamespace>
    <AssemblyName>QuickByte.Core</AssemblyName>
    <AssemblyTitle>QuickByte Download Engine</AssemblyTitle>
    <Description>Headless segmented-download engine: multi-connection HTTP transfers with pause, resume, retry and bandwidth limiting.</Description>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <!--
    The one NuGet reference in the solution, and a compile-time one only.
    Helpers/SecretProtector.cs needs DPAPI so an FTP or HTTP password is never
    written into downloads.json as plain text, and ProtectedData is not in the
    net8.0-windows targeting pack this library builds against.

    Nothing is deployed: the implementation ships inside the
    Microsoft.WindowsDesktop.App shared framework that QuickByte.UI already
    runs on, so the SDK strips the runtime asset (its deps.json entry is empty)
    and the installer needs no extra file. Pinned to 8.0.0 to match that
    framework.
  -->
  <ItemGroup>
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

</Project>
