<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      Matches QuickByte.Agent exactly, for the same reason the Core suite matches
      Core: the agent is a net8.0-windows process and the things worth testing
      about it (a named mutex, a Windows command line, a path in the user's
      profile) only mean anything there.
    -->
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <PlatformTarget>x64</PlatformTarget>

    <RootNamespace>QuickByte.Agent.Tests</RootNamespace>
    <!--
      The assembly name is load-bearing: QuickByte.Agent names it in an
      InternalsVisibleTo, and every type in the agent is internal.
    -->
    <AssemblyName>QuickByte.Agent.Tests</AssemblyName>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <!--
    Same packages, and the same reasoning, as tests/QuickByte.Core.Tests: these
    deploy a DLL, and they are safe only because nothing in src/ references a
    test project, so none of it can reach src/QuickByte.UI/bin/Release or the
    installer's [Files] list. See CLAUDE.md.
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <!--
    Core arrives with it, which is what these tests want: the queues and
    schedules the loop reasons about are Core's types, and the point of the
    agent is that it asks Core the same questions the app does.
  -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\QuickByte.Agent\QuickByte.Agent.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
