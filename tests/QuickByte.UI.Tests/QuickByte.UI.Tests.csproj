<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <!--
      The project under test is a WinForms application, so its assembly cannot
      be referenced without this — even though nothing here builds a form.
    -->
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <PlatformTarget>x64</PlatformTarget>

    <RootNamespace>QuickByte.UI.Tests</RootNamespace>
    <!-- Named in QuickByte.UI's InternalsVisibleTo. -->
    <AssemblyName>QuickByte.UI.Tests</AssemblyName>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <!--
    Same packages, and the same reasoning, as the other two test projects: they
    deploy a DLL, and that is safe only because nothing in src/ references a test
    project, so none of it reaches src/QuickByte.UI/bin/Release or the
    installer's [Files] list. See CLAUDE.md.
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\QuickByte.UI\QuickByte.UI.csproj" />
  </ItemGroup>

  <!--
    The checked-in icon, linked rather than copied into the repo twice:
    BrandIconTests reads it to prove it still carries the sizes BrandIcon draws.
    It is the one image asset in the repository and the one thing here that
    cannot be regenerated by looking at it.
  -->
  <ItemGroup>
    <None Include="..\..\src\QuickByte.UI\Assets\quickbyte.ico" Link="quickbyte.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
