{
  "manifest_version": 3,
  "name": "QuickByte Integration",
  "version": "1.5.0",
  "description": "Takes downloads over from your browser and hands them to the QuickByte download manager.",

  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "permissions": [
    "downloads",
    "storage",
    "cookies",
    "contextMenus"
  ],

  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],

  "background": {
    "scripts": ["shared.js", "background.js"]
  },

  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["shared.js", "content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],

  "options_page": "options.html",

  "action": {
    "default_popup": "popup.html",
    "default_title": "QuickByte Integration",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },

  "browser_specific_settings": {
    "gecko": {
      "id": "quickbyte-integration@ismailaatif.com",
      "strict_min_version": "128.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
